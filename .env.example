# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# If MongoDB is running locally or on Atlas, provide URI.
# If not accessible, server seamlessly uses persistent file store.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_part_time_jobs

# JWT Secret
JWT_SECRET=super_secret_jwt_key_job_platform_2026_dev

# AI Matching Configuration
# Options: mock | huggingface
# Set to 'huggingface' to enable LLM-powered cover letter generation via Hugging Face
AI_MODE=mock

# Hugging Face Inference API token
# Required for AI-powered cover letter generation (generateApplicationMessage)
# Get your free token at: https://huggingface.co/settings/tokens
# Model used: mistralai/Mistral-7B-Instruct-v0.2
HF_TOKEN=your_hugging_face_token_here

# Client URL for CORS
CLIENT_URL=http://localhost:5173
